<section id="soporte" class="ticket-section">
  <div class="ticket-card">
    <div class="ticket-head">
      <p class="badge">Soporte Técnico</p>
      <h2 class="title">Levanta un Ticket</h2>
      <p class="desc">¿Tuviste un problema, encontraste un bug o tienes una sugerencia? Envíanos un mensaje y lo revisaremos.</p>
    </div>

    <form id="ticket-form" class="ticket-form">
      <div class="input-group">
        <label for="titulo">Titulo</label>
        <input type="text" id="titulo" name="titulo" placeholder="Ej. Nuevo Ticket" required />
      </div>

      <div class="input-group">
        <label for="asunto">Asunto</label>
        <input type="text" id="asunto" name="asunto" placeholder="Sugerencia" required />
      </div>

      <div class="input-group">
        <label for="tipo">Tipo de ticket</label>
        <div class="select-wrapper">
          <select id="tipo" name="tipo" required>
            <option value="" disabled selected hidden>Selecciona una opción</option>
            <option value="Sugerencia"> Sugerencia de mejora</option>
            <option value="Frontend"> Reportar un Error / Bug de diseño </option>
            <option value="Backend">Reportar un Error / Bug de funcionalidad</option>
            <option value="Bug">Reportar un error (se desconoce el tipo)</option>
          </select>
        </div>
      </div>

      <div class="input-group">
        <label for="mensaje">Detalle del mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="4" placeholder="Describe a detalle el problema o tu propuesta..." required></textarea>
      </div>

      <button type="submit" class="btn-submit">
        <span>Enviar Ticket</span>
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('ticket-form') as HTMLFormElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    try {
    
      const response = await fetch('http://192.168.1.7:3000/api/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        alert('Ticket enviado con éxito a tu sistema.');
        form.reset();
      } else {
        alert('Error al procesar el ticket');
      }
    } catch (err) {
      console.error(err);
      alert('Error de conexión con el backend.');
    }
  });
</script>

